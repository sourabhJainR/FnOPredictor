PORT=3000
CACHE_TTL_MS=15000
# Free one-year read-only Analytics Token from Upstox Developer Apps > Analytics.
UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENT_KEY=BSE_INDEX|SENSEX
POLL_SECONDS=15
CAPITAL_INR=10000
RISK_LIMIT_INR=2000
